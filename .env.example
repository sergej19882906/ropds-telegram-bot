# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ROPDS Server URL (без слэша на конце)
ROPDS_URL=http://localhost:8081

# HTTP Basic Auth (если включено в ROPDS)
ROPDS_USER=
ROPDS_PASSWORD=

# Comma-separated Telegram user IDs. Leave empty to allow all users.
ALLOWED_USER_IDS=

# Логирование (trace, debug, info, warn, error)
RUST_LOG=info