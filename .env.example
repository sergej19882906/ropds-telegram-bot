# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ROPDS Server URL (без слэша на конце)
ROPDS_URL=http://localhost:8081

# HTTP Basic Auth (если включено в ROPDS)
ROPDS_USER=
ROPDS_PASSWORD=

# Comma-separated Telegram user IDs. Leave empty to allow all users.
ALLOWED_USER_IDS=

# Логирование (trace, debug, info, warn, error)
RUST_LOG=info

# Пустой ALLOWED_USER_IDS разрешает всех. Для production задайте ID
# или ALLOW_ALL_USERS=false вместе с ALLOWED_USER_IDS.
ALLOW_ALL_USERS=

# Лимиты
MAX_BOOK_SIZE_MB=50
MAX_COVER_SIZE_MB=5
MAX_FEED_SIZE_MB=10
MAX_CONCURRENT_DOWNLOADS=2
REQUEST_COOLDOWN_SECS=2
BOOKS_PER_PAGE=5

# Файл готовности для Docker healthcheck
# BOT_READY_FILE=/tmp/ropds-bot-ready
