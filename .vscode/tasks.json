{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo check",
      "type": "shell",
      "command": "cargo",
      "args": ["check"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo build (debug)",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo build (release)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--release"],
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo run",
      "type": "shell",
      "command": "cargo",
      "args": ["run"],
      "options": {
        "env": {
          "RUST_LOG": "info"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo run (debug logs)",
      "type": "shell",
      "command": "cargo",
      "args": ["run"],
      "options": {
        "env": {
          "RUST_LOG": "debug"
        }
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo",
      "args": ["test"],
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo clippy",
      "type": "shell",
      "command": "cargo",
      "args": ["clippy", "--all-targets", "--all-features", "--", "-D", "warnings"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo fmt",
      "type": "shell",
      "command": "cargo",
      "args": ["fmt", "--all"]
    },
    {
      "label": "cargo clean",
      "type": "shell",
      "command": "cargo",
      "args": ["clean"]
    },
    {
      "label": "cargo update",
      "type": "shell",
      "command": "cargo",
      "args": ["update"]
    }
  ]
}
